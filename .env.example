# CargoLens environment — copy to .env and fill (never commit real values)
# See isocode-preparation/07-DEPLOYMENT-EXPLAINED.md for provider verification notes.

# Postgres connection string (local dev or Supabase/AWS Mumbai etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cargolens"

# Session signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# AI provider (paid tier ONLY — unpaid tiers are not privacy-acceptable for this client, ADR-04)
GEMINI_API_KEY=""

# Private object storage (Supabase project in an India region, or fallback per file 07)
STORAGE_URL=""
STORAGE_SERVICE_ROLE_KEY=""

# Seed guard — seed script refuses to run against a non-demo database unless true
# (_SYNTHETIC demo data only, per ADR-09)
SEED_SYNTHETIC="false"
